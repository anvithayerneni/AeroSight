# Environment Variables for AeroSight Platform
# Copy this file to .env and adjust variables as needed

# Application Settings
APP_NAME=AeroSight
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=3000

# Database Configuration (DuckDB by default for zero-cost local OLAP)
DATABASE_TYPE=duckdb
DUCKDB_PATH=data/warehouse.duckdb

# PostgreSQL (Optional - for PostgreSQL profile)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aerosight
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_STREAMING_SPEED=10
KAFKA_TOPIC_FLIGHTS=flights
KAFKA_TOPIC_FLIGHT_STATUS=flight_status
KAFKA_TOPIC_AIRPORT_EVENTS=airport_events
KAFKA_TOPIC_WEATHER_EVENTS=weather_events
KAFKA_TOPIC_BAGGAGE_EVENTS=baggage_events

# Apache Spark Settings
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
JAVA_HOME=/opt/homebrew/opt/openjdk@17

# Data Lake Paths
DATA_RAW_DIR=data/raw
DATA_BRONZE_DIR=data/bronze
DATA_SILVER_DIR=data/silver
DATA_GOLD_DIR=data/gold
DATA_SAMPLE_DIR=data/sample

# Machine Learning Artifacts
ML_MODEL_DIR=ml/models

# Airflow Configuration (Optional local instance)
AIRFLOW_HOME=airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
